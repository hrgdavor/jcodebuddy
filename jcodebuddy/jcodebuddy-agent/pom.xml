<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>hr.hrg.jcodebuddy</groupId>
        <artifactId>jcodebuddy-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>jcodebuddy-agent</artifactId>
    <name>JCodeBuddy Agent</name>
    <description>Headless JCodeBuddy agent: watches through fs-meta, runs proposal-based Java tools,
        and serves the jsx6 batch dashboard and tool socket.</description>

    <dependencies>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>jcodebuddy-watch</artifactId>
        </dependency>
        <!-- The agent's dashboard is now a live tool: its verbs are published over the same Unix socket
             contract the compiler uses, so the host can proxy them at /api/tools. -->
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>jcodebuddy-ipc</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>jcodebuddy-tool-api</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>jcodebuddy-tool-builder</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>jcodebuddy-tool-java</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>jcodebuddy-tool-hipster-ioc</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>jcodebuddy-tool-hipster-entity</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>jcodebuddy-builder</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-java</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-java-25</artifactId>
            <version>${openrewrite.version}</version>
        </dependency>

        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>hr.hrg.watch2.agent.WatchAgent</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>hr.hrg.watch2.agent.WatchAgent</mainClass>
                                </transformer>
                            </transformers>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
