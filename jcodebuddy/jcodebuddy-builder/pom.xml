<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>hr.hrg.jcodebuddy</groupId>
        <artifactId>jcodebuddy-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>jcodebuddy-builder</artifactId>
    <name>JCodeBuddy Builder</name>
    <description>Component for processing and generating Record builders</description>

    <dependencies>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>jcodebuddy-builder-api</artifactId>
        </dependency>
        <!-- The engine, for the one splice path. Step 3.0n collapsed the second `SourceSplicer` this module used to
             carry; the survivor lives in `jcodebuddy-core` (`engine.source.SourceSplicer`), so a generator that
             splices declares the dependency rather than owning a copy of the primitives. This is the same shape
             `hipster-entity-tooling` already has. -->
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>jcodebuddy-core</artifactId>
        </dependency>
        <!-- OpenRewrite, arriving as JavaParser leaves (Phase 6 of the rewrite-migration plan).
             `rewrite-java` is a facade needing exactly one version-specific parser, and
             `rewrite-java-25` is the only OpenRewrite artifact the parent does not manage. -->
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-java</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-java-25</artifactId>
            <version>${openrewrite.version}</version>
        </dependency>
        <!-- `javaparser-core` was removed here on 2026-09-22 (Phase 6 of the rewrite-migration plan):
             every source in this module parses through OpenRewrite now, and the recorded gate
             (`RecordBuilderProcessorTest`, 5 tests) is green without it. A module that still declares a
             parser it no longer imports is a dependency the next reader will assume is load-bearing. -->
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>java-watch-core</artifactId>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
