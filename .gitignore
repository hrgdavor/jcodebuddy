# JCodeBuddy tool output. A `.jcodebuddy/` directory appears only in modules that apply
# `project-automation`, and each one carries its own .gitignore as the authority (see
# hipster-entity-example/.jcodebuddy/README.md and
# doc-hipster-entity/architecture/decisions/DEC-026.md). These entries are the
# belt-and-braces net for the root and for any module that forgets its own; the tracked
# subtrees (context/, reports/) are deliberately absent, so they stay visible in
# `git status`.
.jcodebuddy/metadata/
.jcodebuddy/agent-state/
.jcodebuddy/worktrees/

# Compatibility: the watch agent's cache/audit root before it moved under .jcodebuddy.
.watch

# Node / Gradle trees inside the tooling subprojects
vscode-jwa/node_modules
intellij-jwa/.gradle
vscode-jswa/node_modules
jswa-core/node_modules
intellij-jswa/.gradle
node_modules
.vscode-test
/webview-vscode/out
/webview-vscode/*.vsix

# Agent harness state. `.kilo/plans` holds untracked per-round plans; the tool's own
# config (package.json, node_modules) is covered above.
.kilo/plans
