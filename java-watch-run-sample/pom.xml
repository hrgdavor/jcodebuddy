<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>hr.hrg.jcodebuddy</groupId>
        <artifactId>jcodebuddy-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>java-watch-run-sample</artifactId>
    <packaging>jar</packaging>

    <name>java-watch-run-sample</name>
    <description>Sample project for testing the java-watch-run hot-reload daemon</description>

    <dependencies>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>java-watch-run</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src</sourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven.dependency.plugin.version}</version>
                <executions>
                    <execution>
                        <id>copy-runtime-deps</id>
                        <!-- `package`, not `generate-resources`. `copy-dependencies` resolves its inputs
                             as artifacts, and in a reactor a sibling module's artifact does not exist
                             until that module has been packaged: bound to `generate-resources` this
                             failed every `clean compile` and `clean test` of the reactor with
                             "Artifact has not been packaged yet … see MDEP-187", which meant a
                             whole-reactor test run could never reach the modules after this one. The
                             plugin's own guidance is to run it after packaging, and this module's purpose
                             — a runnable sample with its runtime jars in `lib/` — is exactly a
                             post-package step. -->
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/lib</outputDirectory>
                            <includeScope>compile</includeScope>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
