<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>hr.hrg.jcodebuddy</groupId>
        <artifactId>jcodebuddy-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>merge-java</artifactId>
    <packaging>jar</packaging>

    <name>merge-java</name>
    <description>
        Reliable resolution of common merge conflicts. Resolves import additions,
        comment additions, constant additions, overloads and widening type changes
        automatically; offers fix paths for renames, package moves and ambiguous
        body edits; and remembers per-branch decisions so repeated base-branch
        updates stop re-conflicting.
    </description>

    <properties>
        <!--
            Matches the parent's managed OpenRewrite version. Pinned here only
            because the version-specific parser implementation below is not
            managed by the parent.
        -->
        <openrewrite.version>8.90.4</openrewrite.version>
        <jgit.version>6.10.0.202406032230-r</jgit.version>
        <mockito.version>5.13.0</mockito.version>
    </properties>

    <dependencies>
        <!-- Reading the decisions a reviewer exported from the review page (plan step 4.3). Jackson 3 is
             the version the parent manages; declaring it makes the dependency intentional rather than
             inherited from OpenRewrite's transitive graph. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- OpenRewrite versions are managed by the parent POM. OpenRewrite
             bundles its own Java parser, so no separate JavaParser dependency
             is needed. -->
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-java</artifactId>
        </dependency>
        <!--
            rewrite-java is a facade: it needs one version-specific parser
            implementation on the classpath. -25 is the newest OpenRewrite 8.90.4
            provides (the set is 8, 11, 17, 21, 25), and it requires a JDK 25
            runtime, so this module builds and runs on 25 - the same level as the
            parent.
        -->
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-java-25</artifactId>
            <version>${openrewrite.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-maven</artifactId>
        </dependency>

        <!-- JGit: branch and history access straight from the library, so the
             module never shells out to git. -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
            <version>${jgit.version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>
                    <!-- Test classes are distributed across forked JVMs. This suite was a single
                         sequential fork, so its wall clock was the sum of its classes: 750 tests in
                         530 s of test time, dominated by six that each wait on a spawned Bun process
                         or an in-process javac. Forking keeps each class in its own JVM, which is the
                         isolation these tests already assume (@TempDir per test, in-memory stores),
                         and turns that sum into roughly its longest member. -->
                    <forkCount>8</forkCount>
                    <reuseForks>true</reuseForks>
                    <!-- And classes run concurrently inside each fork, so the heavy classes are not
                         serialised behind one another. `classes` rather than `methods` on purpose:
                         two tests of one class share its @TempDir and its target/ output, while two
                         different classes do not - the isolation boundary these tests actually have.
                         Sized to the machine, which has 32 cores: 8 x 4 keeps every core busy on the
                         750 tests without serialising a class behind another. -->
                    <parallel>classes</parallel>
                    <threadCount>4</threadCount>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
