<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>hr.hrg.jcodebuddy</groupId>
        <artifactId>jcodebuddy-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>hipster-entity-example</artifactId>
    <packaging>jar</packaging>

    <name>hipster-entity-example</name>
    <description>Example module for exploring entity definitions and data access patterns.</description>

    <dependencies>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>hipster-entity-core</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>hipster-entity-api</artifactId>
        </dependency>
        <!-- The runnable PersonDemo (plan.dsflash § 9/4.2) shows the JSON side end to end, so the
             example takes the Jackson module. It is a real dependency of the demo, not of any
             library module: no library POM gains a Jackson entry from this. -->
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>hipster-entity-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Dev-time only, and on the compile classpath only so that the explicit exec goals below
             and `scripts\gen.cmd`'s classpath export can see the generator. The generator is a side
             tool: it is NOT bound to a lifecycle phase, so a plain `mvn compile` neither runs nor
             needs it. It is `provided` because nothing in the example's runtime or tests needs
             the tooling, and the tooling must never become a runtime dependency of an application —
             see AGENTS.md §2. -->
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>hipster-entity-tooling</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The generator is a SIDE TOOL, not a build step.

                 Neither execution below carries a <phase>, so neither is bound to the lifecycle:
                 `mvn compile`, `mvn package`, `mvn test` and every other build run the ordinary
                 compile of the committed sources and nothing else. There is no annotation
                 processing, no compile hook and no generated-sources root. This is the DEC-019 /
                 AGENTS.md §1 model taken literally — the generated .java is committed, ordinary,
                 IDE-navigable source, and the tool that wrote it runs beside the build, not inside
                 it: on demand, or continuously in watch mode. An IDE sidecar would layer on top of
                 that later; nothing here requires one.

                 The two executions exist so the same entry points can be reached explicitly, with
                 their ordinary CLI flags rather than -D system properties, so a manual run and any
                 future automation share one flag surface:

                   mvn -o -f hipster-entity-example/pom.xml exec:java@hipster-entity-preflight
                   mvn -o -f hipster-entity-example/pom.xml exec:java@hipster-entity-generate

                 1. `hipster-entity-preflight` runs GeneratorPreflight, which asserts that the tooling
                    on the classpath understands the flag surface below before anything is written.
                 2. `hipster-entity-generate` runs the generator itself, which refuses — at every
                    entry point — to write generated .java under a `.jcodebuddy/` directory, and
                    records what it ran with in `.jcodebuddy/metadata/entity/generation.json`.

                 Both invocations above resolve the tooling from the local repository, which is why
                 `scripts\gen.cmd` is the recommended entry point: it compiles the tooling in the
                 same reactor, exports the reactor's classpath, and invokes the generator directly
                 with `java -cp`. That path needs no `mvn install` and builds no jar. See
                 `codebuddy.md` § 3 for all three ways to run a pass.

                 `exec:java` defaults to the RUNTIME classpath scope, which excludes `provided`
                 dependencies — and the tooling is `provided` on purpose so it never becomes a
                 transitive runtime dependency of an application (AGENTS.md §2). The
                 classpathScope below is what puts it in front of exec:java.

                 Generated .java is regenerated IN PLACE under src/main/java (the committed source is
                 the source of truth, AGENTS.md §1), while the metadata JSON report goes to this
                 module's own `.jcodebuddy/metadata/entity` — the marker directory that says "this
                 module uses JCodeBuddy". The pass never adds untracked files to a source tree:
                 `.jcodebuddy/metadata/` is ignored by `.jcodebuddy/.gitignore`, and the layout is
                 documented in `.jcodebuddy/README.md`.

                 This is deliberately NOT a new hipster-entity-maven-plugin module (§ 8.8/3.23). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>hipster-entity-preflight</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>hr.hrg.hipster.entity.tooling.GeneratorPreflight</mainClass>
                            <classpathScope>compile</classpathScope>
                        </configuration>
                    </execution>
                    <execution>
                        <id>hipster-entity-generate</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>hr.hrg.hipster.entity.tooling.EntityMetadataGenerator</mainClass>
                            <!-- exec:java's default classpath scope is RUNTIME, which excludes
                                 `provided` dependencies — and the tooling must stay `provided` so it
                                 never becomes a transitive runtime dependency of an application
                                 (AGENTS.md §2). Compile scope is what puts the generator and its
                                 JavaParser/Jackson classpath in front of exec:java. -->
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>${project.basedir}/src/main/java</argument>
                                <argument>${project.basedir}/.jcodebuddy/metadata/entity</argument>
                                <argument>--java-out</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                                <argument>--packages</argument>
                                <argument>hr.hrg.hipster.entityexample.person.entity,hr.hrg.hipster.entityexample.paymentMethod.entity</argument>
                                <!-- Task 1.13: run the entity rules on every generation pass. REPORT
                                     (the bare flag) prints each issue to the pass log and continues,
                                     so the validator's output is visible on every manual or watched
                                     pass without blocking a project whose own conventions differ
                                     from the tooling's advisory ones. A project that wants the gate
                                     passes the STRICT mode (or runs the `validate` subcommand) and the
                                     pass then refuses to write until the issues are fixed. -->
                                <argument>--validate</argument>
                                <!-- The run record: what this pass ran with, next to the entity JSON in
                                     the metadata tree. Machine-readable, ignored by git, and the only
                                     place "which generator revision produced this tree" survives the
                                     pass that produced it. -->
                                <argument>--run-record</argument>
                                <argument>${project.basedir}/.jcodebuddy/metadata/entity/generation.json</argument>
                                <!-- NO SQL-generation flag here, deliberately. SQL generation (the
                                     generated `<View>RowAdapter` / `<View>Binder` pair) is a
                                     draft/exploration in the tooling and is strictly OPT-IN: it runs
                                     only when a project asks for it with the tooling's adapter flag,
                                     and this example does not. The same rule applies to whatever SQL
                                     support comes later: it may never be part of the default pass.
                                     See hipster-entity-tooling/README.md and
                                     doc-hipster-entity/user/patterns/jdbc-row-adapter.md. -->
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>junit5</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>
    </profiles>
</project>
