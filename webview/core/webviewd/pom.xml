<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>hr.hrg.jcodebuddy</groupId>
        <artifactId>jcodebuddy-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <!-- Three levels down, next to the core it builds on: this is the standalone host of the webview
             product, not a separate tool. See webview/PLAN-webview-suite.md, Phase 2 and decision D9. -->
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>webviewd</artifactId>
    <name>WebView Daemon</name>
    <description>
        The standalone page host: the reference implementation of the page contract, and the only one that
        needs no editor. It serves a project's pages on loopback, answers the frozen GET /open and
        GET /health, serves files and pages through core's page server, publishes itself in
        .jcodebuddy/webview/host.json and at /.well-known/webview.json, and drives whichever EditorHost is
        available - a CLI adapter when one is found, nothing at all when none is. Everything it enforces
        (origin allow-list, token, path jail, rate limit) comes from webview-core, so this module holds no
        second copy of the security model.
    </description>

    <dependencies>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>webview-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>hr.hrg.webview.webviewd.WebviewdMain</mainClass>
                                </transformer>
                            </transformers>
                            <finalName>webviewd</finalName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
