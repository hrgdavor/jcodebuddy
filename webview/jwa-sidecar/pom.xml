<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>hr.hrg.jcodebuddy</groupId>
        <artifactId>jcodebuddy-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <!-- The module moved under webview/ - it is the same product as the webview hosts, reached over
             LSP instead of over a webview - so the parent is one level up, not at the repository root.
             See webview/PLAN-webview-suite.md, decision D9. -->
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>jwa-sidecar</artifactId>
    <name>JWA Sidecar</name>
    <description>LSP sidecar for JWA Agent synchronization and monitoring, and the LSP transport of the
        webview product: it drives an editor from a page over window/showDocument and workspace/applyEdit.</description>

    <dependencies>
        <!-- The host-neutral half of the webview product: the origin allow-list, the rate limiter and the
             path jail that this sidecar's HTTP surface previously did without, and the Navigator that
             gives its LSP navigation the same semantics as every other host. -->
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>webview-core</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>java-watch-core</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>jwa-builder-api</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>jwa-builder</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.lsp4j</groupId>
            <artifactId>org.eclipse.lsp4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>hr.hrg.watch2.sidecar.SidecarApp</mainClass>
                                </transformer>
                            </transformers>
                            <finalName>jwa-sidecar</finalName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
