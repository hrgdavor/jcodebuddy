{
    "name": "vscode-webview-explorer",
    "displayName": "WebView Explorer",
    "description": "A WebView explorer for VS Code with an HTTP bridge to open files.",
    "version": "0.0.1",
    "publisher": "davorhrg",
    "author": {
        "name": "Davor Hrg"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/davorhrg/vscode-webview-explorer"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "webview-explorer.refresh",
                "title": "Refresh",
                "category": "WebView Explorer",
                "icon": "$(refresh)"
            },
            {
                "command": "webview-explorer.openSettings",
                "title": "Open Settings",
                "category": "WebView Explorer",
                "icon": "$(settings-gear)"
            },
            {
                "command": "webview-explorer.openInWebView",
                "title": "Open in WebView Explorer",
                "category": "WebView Explorer"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "webview-explorer.refresh",
                    "when": "view == webview-explorer-view",
                    "group": "navigation"
                },
                {
                    "command": "webview-explorer.openSettings",
                    "when": "view == webview-explorer-view",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "when": "resourceExtname == .html",
                    "command": "webview-explorer.openInWebView",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "when": "resourceExtname == .html",
                    "command": "webview-explorer.openInWebView",
                    "group": "navigation"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "webview-explorer-container",
                    "title": "WebView Explorer",
                    "icon": "$(browser)"
                }
            ]
        },
        "views": {
            "webview-explorer-container": [
                {
                    "type": "webview",
                    "id": "webview-explorer-view",
                    "name": "WebView Explorer"
                }
            ]
        },
        "configuration": {
            "title": "WebView Explorer",
            "properties": {
                "webviewExplorer.port": {
                    "type": "integer",
                    "default": 18882,
                    "description": "Port for the HTTP bridge server."
                },
                "webviewExplorer.allowedOrigins": {
                    "type": "string",
                    "default": "",
                    "description": "Comma-separated list of allowed origins for the HTTP bridge."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js",
        "pretest:unit": "npm run compile",
        "test:unit": "node ./src/test/BridgePolicy.test.js"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.1",
        "@types/node": "16.x",
        "@types/sinon": "^21.0.0",
        "@types/vscode": "^1.80.0",
        "@typescript-eslint/eslint-plugin": "^5.59.8",
        "@typescript-eslint/parser": "^5.59.8",
        "@vscode/test-electron": "^2.3.2",
        "eslint": "^8.41.0",
        "glob": "^8.1.0",
        "mocha": "^10.2.0",
        "sinon": "^21.0.1",
        "typescript": "^5.1.3"
    }
}