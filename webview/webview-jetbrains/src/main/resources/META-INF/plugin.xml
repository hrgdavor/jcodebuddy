<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<!--
  id, name, vendor, description, change-notes and idea-version are patched in by the Gradle
  `patchPluginXml` task from the `intellijPlatform { pluginConfiguration { ... } }` block in
  build.gradle.kts, so they are not repeated here.
-->
<idea-plugin>
    <depends>com.intellij.modules.platform</depends>
    <!--
      The JCEF module must be declared here, not only in gradle.properties' platformBundledModules:
      that property is the compile classpath, while <depends> is what puts
      intellij.platform.ui.jcef.jar on the plugin classloader at runtime. Without this line every
      JCEF type (JBCefApp, JBCefBrowser, JBCefBrowserBase, JBCefJSQuery) is unresolvable and the tool
      window fails to instantiate with a misleading "Cannot find suitable constructor" error.
      See plan.reimplement.md, finding F8.
    -->
    <depends>com.intellij.modules.jcef</depends>
    <!--
      The Java module, for the LSP client half merged in step 3.0q: `platform.lsp.serverSupportProvider`
      below starts `webview/jwa-sidecar` as this project's Java language server, and the LSP API for it ships
      with the Java module. Same F8 rule as the JCEF line above — compile classpath is not runtime.
    -->
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.serverSupportProvider implementation="hr.hrg.jetbrains.webview.lsp.SidecarLspServerSupportProvider"/>
        <toolWindow factoryClass="hr.hrg.jetbrains.webview.toolWindow.JcefToolWindowFactory" id="WebView Explorer" anchor="right" icon="AllIcons.General.Web" secondary="true"/>
        <projectService serviceImplementation="hr.hrg.jetbrains.webview.services.PluginStateService"/>
        <projectService serviceImplementation="hr.hrg.jetbrains.webview.services.HttpBridgeService"/>
        <projectService serviceImplementation="hr.hrg.jetbrains.webview.bridge.NavigatorService"/>
        <projectService serviceImplementation="hr.hrg.jetbrains.webview.toolWindow.WebViewService"/>
        <postStartupActivity implementation="hr.hrg.jetbrains.webview.services.HttpBridgeStartupActivity"/>
        <projectConfigurable parentId="tools" instance="hr.hrg.jetbrains.webview.settings.WebViewSettingsConfigurable"
                             id="hr.hrg.jetbrains.webview.settings.WebViewSettingsConfigurable"
                             displayName="WebView Explorer" nonDefaultProject="true"/>
    </extensions>

    <actions>
        <action id="hr.hrg.jetbrains.webview.actions.ToggleToolWindowAction"
                class="hr.hrg.jetbrains.webview.actions.ToggleToolWindowAction"
                text="Toggle WebView Explorer"
                description="Toggles the WebView Explorer tool window">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift W"/>
        </action>
        <action id="hr.hrg.jetbrains.webview.actions.OpenFileInWebViewAction"
                class="hr.hrg.jetbrains.webview.actions.OpenFileInWebViewAction"
                text="Open in WebView Explorer"
                description="Opens the selected file in WebView Explorer">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="EditSource"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
