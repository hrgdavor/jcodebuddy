<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>hr.hrg.jcodebuddy</groupId>
        <artifactId>jcodebuddy-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>project-automation</artifactId>
    <packaging>jar</packaging>

    <name>project-automation</name>
    <description>Dev-time orchestrator: contains project-specific generators, watchers, and LSP sidecar wiring.</description>

    <dependencies>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>hipster-entity-api</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>java-watch-core</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>jwa-builder</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>hipster-entity-tooling</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!--
            javaparser-core was removed with the `hr.hrg.rewrite` staging package (Phase 6 of the
            rewrite-migration plan). That package was the only consumer in this module, and it never
            compiled: it referenced eight types that exist nowhere (`TypeTree`, `MethodTree`,
            `ClassTree`, `FieldTree`, `AnnotationTree`, `EnumDeclarationTree`, `CodeResolver`,
            `ViewMetaImpl`) — measured at 200 errors across 14 files once two syntax errors in front of
            them were fixed. Nothing outside this module referenced it, and this module's own live
            classes did not either, so removing it restored a compiling module and unblocked
            `java-watch-agent`, which depends on this artifact.
        -->
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>metadata-server</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>metadata-mcp-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
