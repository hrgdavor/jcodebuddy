<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>hr.hrg.jcodebuddy</groupId>
        <artifactId>jcodebuddy-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>project-automation</artifactId>
    <packaging>jar</packaging>

    <name>project-automation</name>
    <description>Dev-time orchestrator: contains project-specific generators, watchers, and LSP sidecar wiring.</description>

    <dependencies>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>hipster-entity-api</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>java-watch-core</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>jwa-builder</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>hipster-entity-tooling</artifactId>
        </dependency>
        <!--
            The generator SPI, which is a shared library and not this module's own. It lives in
            `jcodebuddy-codegen-api` so that a tool which generates code (java-watch-agent is the one
            that forced the split) can implement a generator without depending on a project's private
            dev-time assistant. See that module's POM.
        -->
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>jcodebuddy-codegen-api</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!--
            javaparser-core was removed with the `hr.hrg.rewrite` staging package (Phase 6 of the
            rewrite-migration plan). That package was the only consumer in this module, and it never
            compiled: it referenced eight types that exist nowhere (`TypeTree`, `MethodTree`,
            `ClassTree`, `FieldTree`, `AnnotationTree`, `EnumDeclarationTree`, `CodeResolver`,
            `ViewMetaImpl`) — measured at 200 errors across 14 files once two syntax errors in front of
            them were fixed. Nothing outside this module referenced it, and this module's own live
            classes did not either, so removing it restored a compiling module and unblocked
            `java-watch-agent`, which depends on this artifact.
        -->
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>metadata-server</artifactId>
        </dependency>
        <dependency>
            <groupId>hr.hrg.jcodebuddy</groupId>
            <artifactId>metadata-mcp-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                NEVER INSTALLED, NEVER DEPLOYED — enforced here rather than asked for in a document.

                A project-automation module is one project's dev-time assistant. It is never a
                deliverable, never shared, and never a dependency of anything that ships (see the
                project-automation README and the root README's dev-time-only guarantee). Publishing it
                to any repository — the local one included — is the one thing it must never do, because
                an outside consumer can then resolve it by accident and take a dependency on a project's
                private tooling. That is a hard rule for JCodeBuddy in general, not a preference of this
                module: see AGENTS.md § 1.

                A bare `mvn install` is the command a newcomer runs for the released libraries, and in
                a reactor it installs every module it builds. This module pulls `java-watch-agent` and
                `hipster-ioc-tooling` from the reactor, and in return they depend on this one
                *within* the reactor — so the module must still compile, and its tests must still run.
                Only the two goals that publish are off.

                `skip` rather than removing the goals: a `maven-install-plugin:install` executed with
                no configuration fails the build with "No goals have been specified", which would break
                the documented command instead of protecting it.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
